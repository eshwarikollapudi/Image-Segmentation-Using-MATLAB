clc;
clear;
close all;

I = imread('text.png');

if islogical(I)
    BW = I;
else
    BW = imbinarize(I);
end

se = strel('disk',5);

eroded = imerode(BW,se);
dilated = imdilate(BW,se);
opened = imopen(BW,se);
closed = imclose(BW,se);

boundary = BW - eroded;

filled = imfill(BW,'holes');

figure;

subplot(2,3,1);
imshow(BW);
title('Original Binary');

subplot(2,3,2);
imshow(eroded);
title('Erosion');

subplot(2,3,3);
imshow(dilated);
title('Dilation');

subplot(2,3,4);
imshow(opened);
title('Opening');

subplot(2,3,5);
imshow(closed);
title('Closing');

subplot(2,3,6);
imshow(boundary);
title('Boundary Extraction');

figure;
imshow(filled);
title('Hole Filling');
